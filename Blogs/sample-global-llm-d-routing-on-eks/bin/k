# k <context> <kubectl args...>  -- kubectl against the test-bed kubeconfig, namespace llm-d by default
D=$(cd "$(dirname "$0")/.." && pwd); CTX=$1; shift
exec "$D/bin/kubectl" --kubeconfig "$D/infra/kubeconfig" --context "$CTX" -n "${NS:-llm-d}" "$@"
