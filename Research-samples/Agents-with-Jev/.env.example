AWS_REGION=us-east-1
AWS_PROFILE=das-aws

# GPT-5.6 Sol through the Bedrock OpenAI-compatible runtime endpoint.
BEDROCK_MODEL_ID=global.openai.gpt-5.6-sol
BEDROCK_ENDPOINT=bedrock-runtime
BEDROCK_MAX_COMPLETION_TOKENS=1200
BEDROCK_REASONING_EFFORT=medium

# Global CRIS short-context pricing defaults as of 2026-09-29.
BEDROCK_INPUT_USD_PER_MILLION=4.00
BEDROCK_OUTPUT_USD_PER_MILLION=20.00

# Obtain a key from TypeSafe and keep it only in .env.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0

REVIEW_CONFIDENCE_THRESHOLD=0.65
SEMANTIC_STATE_TABLE=jev-semantic-state
AGENT_MAX_COMPLETION_TOKENS=1200
